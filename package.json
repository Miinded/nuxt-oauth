{
  "name": "@miinded/nuxt-oauth",
  "version": "1.3.0",
  "description": "Permet de mettre en place rapidement la connexion oauth du backend nestjs",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/miinded/nuxt-oauth.git"
  },
  "contributors": [
    {
      "name": "Miinded Team"
    }
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@miinded/nuxt-api": "^0.0.16",
    "@nuxt/kit": "^3.15.4",
    "@pinia/nuxt": "^0.10.1",
    "@tsndr/cloudflare-worker-jwt": "^3.1.3",
    "nuxt-auth-utils": "^0.5.15"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.0.0",
    "@nuxt/eslint-config": "^1.0.1",
    "@nuxt/module-builder": "^0.8.4",
    "@nuxt/schema": "^3.15.4",
    "@nuxt/test-utils": "^3.15.4",
    "@types/node": "latest",
    "changelogen": "^0.5.7",
    "eslint": "^9.20.1",
    "nuxt": "^3.15.4",
    "pinia": "^3.0.1",
    "typescript": "~5.7.3",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
